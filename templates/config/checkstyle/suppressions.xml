<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
    <!--
      IllegalImport bans server APIs so that the core module stays platform-independent.
      Platform adapter modules are supposed to import those APIs, so the check is suppressed
      for every source file that lives under platforms/.
    -->
    <suppress checks="IllegalImport" files="[\\/]platforms[\\/].*"/>
</suppressions>
